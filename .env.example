# Local testing against an already-running llama.cpp backend.
# Copy to .env if it does not exist, then set your backend key and metadata path.
# Run from the project directory. See docs/configuration.md for normal operation.

# Backend and matching tokenizer/config metadata. No model weights are loaded here.
DECIDER_BACKEND_URL=http://127.0.0.1:5080
DECIDER_METADATA_DIRECTORY=.scratch/decider-metadata
DECIDER_OPERATOR_PROBE_API_KEY=replace-with-backend-api-key

# Manual mode requires a loopback bind. Functional startup checks still run.
DECIDER_SKIP_DEPLOYMENT_IDENTITY_VALIDATION=true

# Public model catalog. These values describe the pinned decider-4b v2.1 metadata.
DECIDER_MODEL_NAME=decider-4b-q4-k-m
DECIDER_MODEL_DESCRIPTION='Local Decider 4B testing'
DECIDER_MODEL_RELEASE_DATE=2026-09-24

# Conservative local capacities and request limits; adjust for your backend.
DECIDER_CONTEXT_CAPACITY=4096
DECIDER_BACKEND_SLOTS=1
DECIDER_ADMISSION_CAPACITY=4
DECIDER_MAX_REQUEST_BYTES=1048576
DECIDER_MAX_QUESTIONS=32
DECIDER_MAX_OPTIONS=255
DECIDER_MAXIMUM_PROBABILITY_COVERAGE=256

# Wrapper listener. Clients send TypeSafe requests to this host and port.
DECIDER_BIND_HOST=127.0.0.1
DECIDER_BIND_PORT=8000

# Opt in to request-stage timing logs; restart the service after changing.
DECIDER_TIMING_LOGGING_ENABLED=false
